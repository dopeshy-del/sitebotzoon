# Telegram
BOT_TOKEN=your_bot_token_here
ADMIN_CHAT_ID=your_telegram_user_id

# TimeWeb Cloud
TIMEWEB_API_TOKEN=your_timeweb_api_token

# PolzaAI
POLZAAI_API_KEY=your_polzaai_key
POLZAAI_USER_ID=your_polzaai_user_id

# Yandex Webmaster
YANDEX_OAUTH_TOKEN=your_yandex_oauth_token
YANDEX_USER_ID=your_yandex_user_id
YANDEX_HOST_ID=https:your-site.ru:443  # формат: https:domain.ru:443

# Пороги уведомлений
TIMEWEB_BALANCE_THRESHOLD=500     # уведомить если баланс < 500 руб
POLZAAI_BALANCE_THRESHOLD=50      # уведомить если баланс < 50 руб

# Расписание (cron-формат)
REPORT_HOUR=9        # час отправки ежедневного отчёта
REPORT_MINUTE=0      # минута
CHECK_INTERVAL=30    # интервал проверки балансов в минутах
